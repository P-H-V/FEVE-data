{"_id":"d4c9052d-e2a6-42aa-85f3-e1017652ad12","number":205,"title":"BERRY & CHIA SMOOTHIE","cuisine":"International","meal_type":"Smoothie","preparation_difficulty":"Easy","preparation_time":"5 mins","servings":"1","image_source":"","source":"https://en.wikibooks.org/wiki/Cookbook:Smoothie","validation":"USDA - chia seeds provide omega-3 (4.9g/oz), fiber (10g); berries provide antioxidants, vitamin C","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"no-dairy","tag_6":"gluten-free","tag_7":"vitamin-c","tag_8":"antioxidants","tag_9":"antioxidant-rich","tag_10":"fiber","tag_11":"omega-3","tag_12":"omega-3-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Mixed berries","principal_ingredient_2":"chia seeds","principal_ingredient_3":"almond milk","principal_ingredient_4":"banana","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"1 cup frozen mixed berries (blueberries, raspberries, strawberries)","ingredient_2":"1 ripe banana","ingredient_3":"2 tbsp chia seeds","ingredient_4":"1 cup unsweetened almond milk","ingredient_5":"1 tbsp almond butter (optional)","ingredient_6":"1 tsp honey or maple syrup (optional)","step_1":"Add almond milk to a blender","step_2":"Add frozen berries, banana, and chia seeds","step_3":"Add almond butter and sweetener if using","step_4":"Blend on high for 1-2 minutes until smooth","step_5":"Let sit for 2 minutes to allow chia seeds to thicken","step_6":"Pour into a glass and serve immediately"}
{"_id":"11be2291-ea66-48a2-8cd5-331ac993e48f","number":206,"title":"BROCCOLI & TOFU STIR-FRY","cuisine":"Asian","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"30 mins","servings":"3","image_source":"","source":"https://en.wikibooks.org/wiki/Cookbook:Stir_fry","validation":"USDA - tofu provides calcium (434mg/block), protein (36g); broccoli provides vitamin C (81mg/cup)","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"vegan","tag_6":"no-dairy","tag_7":"gluten-free","tag_8":"vitamin-c","tag_9":"calcium","tag_10":"calcium-rich","tag_11":"fiber","tag_12":"protein","tag_13":"protein-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Tofu","principal_ingredient_2":"broccoli","principal_ingredient_3":"bell peppers","principal_ingredient_4":"ginger","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"1 block firm tofu (400g), pressed and cubed","ingredient_2":"2 cups broccoli florets","ingredient_3":"1 red bell pepper, sliced","ingredient_4":"1 tbsp fresh ginger, minced","ingredient_5":"3 cloves garlic, minced","ingredient_6":"3 tbsp soy sauce (or tamari for gluten-free)","ingredient_7":"2 tbsp sesame oil","ingredient_8":"1 tbsp cornstarch","ingredient_9":"2 green onions, sliced","ingredient_10":"Sesame seeds for garnish","step_1":"Press tofu for 15 minutes to remove excess water, then cube","step_2":"In a bowl, toss tofu with cornstarch and 1 tbsp soy sauce","step_3":"Heat 1 tbsp sesame oil in a wok over high heat","step_4":"Add tofu and cook until golden brown, about 5-7 minutes","step_5":"Remove tofu and set aside","step_6":"Add remaining oil, then ginger and garlic, stir-fry for 30 seconds","step_7":"Add broccoli and bell pepper, stir-fry for 3-4 minutes","step_8":"Return tofu to wok, add remaining soy sauce","step_9":"Cook for 2 minutes until sauce thickens","step_10":"Garnish with green onions and sesame seeds"}
{"_id":"fc5614e4-b35c-481f-9cc1-68d2f3fa8057","number":207,"title":"BEET & CARROT BORSCHT","cuisine":"Russian","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"6","image_source":"","source":"https://en.wikibooks.org/wiki/Cookbook:Borscht","validation":"USDA - beets provide folate (136mcg/cup), iron (1.1mg); cabbage provides vitamin C (32.6mg/cup)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"no-dairy","tag_7":"gluten-free","tag_8":"complex-carbs","tag_9":"vitamin-c","tag_10":"iron","tag_11":"iron-supporting","tag_12":"folate","tag_13":"folate-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Beets","principal_ingredient_2":"cabbage","principal_ingredient_3":"carrots","principal_ingredient_4":"potatoes","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"3 medium beets, peeled and grated","ingredient_2":"1/2 head cabbage, shredded","ingredient_3":"2 carrots, chopped","ingredient_4":"3 potatoes, diced","ingredient_5":"1 onion, chopped","ingredient_6":"3 cloves garlic, minced","ingredient_7":"2 tbsp tomato paste","ingredient_8":"6 cups vegetable broth","ingredient_9":"2 tbsp sunflower oil","ingredient_10":"1 bay leaf","ingredient_11":"2 tbsp apple cider vinegar","ingredient_12":"Salt and pepper to taste","ingredient_13":"Fresh dill for garnish","step_1":"Heat oil in a large pot over medium heat","step_2":"Sauté onion, carrots, and beets for 5-7 minutes until softened","step_3":"Add garlic and tomato paste, cook for 1 minute","step_4":"Add potatoes, cabbage, broth, and bay leaf","step_5":"Bring to a boil, then reduce heat and simmer for 30 minutes","step_6":"Add apple cider vinegar and season with salt and pepper","step_7":"Remove bay leaf","step_8":"Garnish with fresh dill before serving","step_9":"Serve hot with sour cream (optional, not vegan)"}
