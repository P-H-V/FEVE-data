{"_id":"71d3e0b4-ed8f-43b9-9a82-8702463f39e1","number":196,"title":"EGGPLANT SPREAD","cuisine":"Romanian","meal_type":"Appetizer/Condiment","preparation_difficulty":"Medium","preparation_time":"40 mins (+ cooling)","servings":"6","image_source":"","source":"Traditional Romanian recipe","validation":"USDA - eggplant provides fiber (12g per whole), anthocyanins (nasunin), copper","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"antioxidants","tag_7":"antioxidant-rich","tag_8":"fiber","tag_9":"fiber-rich","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggplant","principal_ingredient_2":"onion","principal_ingredient_3":"oil","principal_ingredient_4":"lemon juice","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Salată de Vinete","freeRecipe":false,"ingredient_1":"2 large eggplants (about 1.5 kg)","ingredient_2":"1 small onion, very finely grated","ingredient_3":"1/2 cup sunflower or olive oil","ingredient_4":"2 tbsp lemon juice","ingredient_5":"Salt to taste","step_1":"Prick eggplants with a fork","step_2":"Roast over gas flame, on a grill, or in 220°C (425°F) oven until skin is charred and flesh is very soft (about 30 minutes)","step_3":"Place roasted eggplants in a bowl, cover, and let steam for 15 minutes","step_4":"Peel off charred skin (reserve a little for smoky flavor if desired)","step_5":"Drain excess liquid from eggplant flesh","step_6":"Place eggplant in a bowl and chop with a knife (do NOT use food processor - texture should be fibrous, not pureed)","step_7":"While eggplant is still warm, slowly add oil in a thin stream, stirring constantly with a wooden spoon","step_8":"Add grated onion and lemon juice","step_9":"Season with salt","step_10":"Chill for at least 1 hour before serving","step_11":"Serve with crusty bread"}
