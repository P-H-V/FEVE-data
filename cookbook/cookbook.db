{"_id":"317745ca-19b5-4efe-b30d-03fdc78e7398","number":9,"title":"PERSIAN SPINACH AND DILL OMELETTE","cuisine":"Iranian/Persian","meal_type":"Main Course/Breakfast","preparation_difficulty":"Medium","preparation_time":"40 mins","servings":"4","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1789256210072_PERSIAN-SPINACH-AND-DILL-OMELETTE.png","source":"Traditional Persian kuku","validation":"USDA - spinach provides iron (6.4mg/cup cooked); eggs provide protein (6g each), vitamin D","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-eggs","tag_7":"iron","tag_8":"iron-rich","tag_9":"folate","tag_10":"folate-rich","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Spinach","principal_ingredient_2":"eggs","principal_ingredient_3":"fresh dill","principal_ingredient_4":"walnuts","principal_ingredient_5":"barberries","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Kuku Esfenaj","freeRecipe":false,"ingredient_1":"500g fresh spinach, chopped","ingredient_2":"6 eggs","ingredient_3":"1/2 cup fresh dill, chopped","ingredient_4":"1/4 cup walnuts, crushed","ingredient_5":"2 tbsp barberries (or currants) - optional","ingredient_6":"2 cloves garlic, minced","ingredient_7":"1/4 cup oil","ingredient_8":"Salt and pepper to taste","step_1":"Wilt spinach in a hot pan for 2-3 minutes, squeeze out excess water, and chop","step_2":"In a bowl, beat eggs","step_3":"Add spinach, dill, walnuts, barberries, garlic, salt, and pepper","step_4":"Heat oil in a non-stick skillet over medium heat","step_5":"Pour egg mixture into skillet","step_6":"Cook for 10 minutes until bottom is set and golden","step_7":"Carefully flip or place under a broiler to cook the top","step_8":"Cut into wedges and serve warm or at room temperature"}
