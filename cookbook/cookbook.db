{"_id":"ded5befa-899f-4ef0-88ed-1a53454f52f6","number":11,"title":"MINESTRONE ALLA GENOVESE","cuisine":"Italian","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"50 mins","servings":"6","image_source":"","source":"Traditional Italian recipe","validation":"USDA - mixed vegetables provide diverse vitamins, minerals, and antioxidants","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"vitamin-c","tag_7":"antioxidants","tag_8":"antioxidant-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Mixed vegetables","principal_ingredient_2":"beans","principal_ingredient_3":"pesto","principal_ingredient_4":"zucchini","principal_ingredient_5":"green beans","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"1 onion, chopped","ingredient_2":"2 carrots, diced","ingredient_3":"2 celery stalks, diced","ingredient_4":"2 potatoes, diced","ingredient_5":"2 zucchini, diced","ingredient_6":"1 cup green beans, cut into 2cm pieces","ingredient_7":"3 tomatoes, chopped (or 1 can crushed tomatoes)","ingredient_8":"1 cup cooked cannellini beans","ingredient_9":"1/2 cup peas (fresh or frozen)","ingredient_10":"1/4 cup pesto alla Genovese (basil pesto)","ingredient_11":"6 cups vegetable broth","ingredient_12":"1/4 cup olive oil","ingredient_13":"Salt and pepper to taste","ingredient_14":"Fresh basil for garnish","ingredient_15":"Grated Parmesan for serving (optional)","step_1":"Heat olive oil in a large pot over medium heat","step_2":"Sauté onion, carrots, and celery for 5-7 minutes","step_3":"Add potatoes and cook for 3-4 minutes","step_4":"Add zucchini, green beans, and tomatoes","step_5":"Pour in vegetable broth and bring to a boil","step_6":"Reduce heat and simmer for 20 minutes","step_7":"Add cannellini beans and peas, cook for 5 more minutes","step_8":"Remove from heat and stir in pesto","step_9":"Season with salt and pepper","step_10":"Serve hot with fresh basil and optional Parmesan cheese"}
{"_id":"4defa1a0-a74e-4456-b966-5877f1197caa","number":12,"title":"PUMPKIN AND COCONUT STEW","cuisine":"Indian","meal_type":"Main Course","preparation_difficulty":"Easy","preparation_time":"40 mins","servings":"4","image_source":"","source":"Traditional Kerala mathanga erissery","validation":"USDA - pumpkin provides extremely high vitamin A (17,000 IU/cup); black-eyed peas provide iron, protein, fiber","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"healthy-fats","tag_8":"vitamin-a","tag_9":"vitamin-a-rich","tag_10":"fiber","tag_11":"fiber-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Pumpkin","principal_ingredient_2":"black-eyed peas (or chickpeas)","principal_ingredient_3":"coconut","principal_ingredient_4":"curry leaves","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Mathanga Erissery","freeRecipe":true,"ingredient_1":"500g pumpkin, peeled and cubed","ingredient_2":"1/2 cup black-eyed peas (lobia), soaked overnight","ingredient_3":"1/2 cup grated coconut","ingredient_4":"1 tsp cumin seeds","ingredient_5":"2 green chilies","ingredient_6":"1/2 tsp turmeric","ingredient_7":"1 tsp mustard seeds","ingredient_8":"2 dried red chilies","ingredient_9":"1 sprig curry leaves","ingredient_10":"2 tbsp coconut oil","ingredient_11":"Salt to taste","step_1":"Cook soaked black-eyed peas in water until tender (about 30 minutes)","step_2":"Add pumpkin and turmeric, cook for 10 more minutes","step_3":"Grind coconut, cumin seeds, and green chilies into a coarse paste","step_4":"Add coconut paste to the pot and simmer for 5 minutes","step_5":"In a separate small pan, heat coconut oil","step_6":"Add mustard seeds (let them splutter), dried red chilies, and curry leaves","step_7":"Pour tempering over the stew","step_8":"Season with salt","step_9":"Serve hot with rice"}
{"_id":"2dcfacc4-ad62-4fa2-807f-a0993cd5abee","number":13,"title":"BEET KVAS","cuisine":"Ukrainian","meal_type":"Beverage","preparation_difficulty":"Medium","preparation_time":"20 mins (+ 3-5 days fermentation)","servings":"Makes 2 liters","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1789340979321_BEET-KVAS.png","source":"Traditional Ukrainian recipe","validation":"Fermentation produces probiotics (Lactobacillus); USDA - beets provide folate, iron, betalains; rye bread provides fermentation bacteria","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"luteal-phase-week-4","tag_3":"fertility-supporting","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"vitamin-c","tag_8":"iron","tag_9":"iron-rich","tag_10":"folate","tag_11":"folate-rich","tag_12":"probiotics","tag_13":"probiotic-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Raw beets","principal_ingredient_2":"rye bread (or sourdough starter)","principal_ingredient_3":"water","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Buryak Kvas","freeRecipe":false,"ingredient_1":"3 medium raw beets, peeled and cut into 2cm cubes","ingredient_2":"1 slice rye bread (or 2 tbsp sourdough starter, for gluten-free)","ingredient_3":"2 tbsp sugar or honey","ingredient_4":"1 tsp salt (optional)","ingredient_5":"2 liters filtered water (non-chlorinated)","ingredient_6":"1 small piece of rye bread for fermentation starter","step_1":"Sterilize a 2-liter glass jar with boiling water","step_2":"Place cubed beets in the jar","step_3":"Add sugar and salt","step_4":"Toast the rye bread slice until very dark (almost burnt) - this provides fermentation bacteria","step_5":"Place the toasted bread into the jar","step_6":"Fill jar with filtered water, leaving 2 inches of space at the top","step_7":"Cover with a cloth secured by a rubber band (not airtight)","step_8":"Place in a dark, room-temperature place (20-24°C / 68-75°F)","step_9":"Let ferment for 3-5 days","step_10":"After 24 hours, bubbles should appear","step_11":"Taste daily - when it reaches desired sourness (usually day 3-4), fermentation is complete","step_12":"Remove and discard the bread","step_13":"Strain the kvas into clean bottles, discarding beets (or reserve for another use)","step_14":"Seal bottles and refrigerate","step_15":"Serve cold as a refreshing drink","step_16":"**Note:** This is a fermented probiotic beverage - start with small amounts (1/4 cup) to allow digestive system to adjust"}
