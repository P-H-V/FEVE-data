{"_id":"5e8e5682-ba69-4808-86d6-20215f0a14b3","number":272,"title":"SPINACH PIE","cuisine":"Greek","meal_type":"Main Course/Breakfast","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"6","image_source":"","source":"Traditional Greek recipe","validation":"USDA - spinach provides iron (6.4mg/cup cooked), folate (263mcg); feta provides calcium","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"calcium","tag_8":"calcium-rich","tag_9":"iron","tag_10":"iron-rich","tag_11":"folate","tag_12":"protein","tag_13":"protein-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Spinach","principal_ingredient_2":"feta cheese","principal_ingredient_3":"filo pastry","principal_ingredient_4":"eggs","principal_ingredient_5":"dill","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"SPANAKOPITA","freeRecipe":false,"ingredient_1":"500g fresh spinach, washed and roughly chopped","ingredient_2":"200g feta cheese, crumbled","ingredient_3":"200g cottage cheese or ricotta","ingredient_4":"3 green onions, finely chopped","ingredient_5":"3 large eggs, lightly beaten","ingredient_6":"1/4 cup fresh dill, chopped","ingredient_7":"1/4 cup fresh parsley, chopped","ingredient_8":"1/2 tsp nutmeg","ingredient_9":"Salt and pepper to taste","ingredient_10":"12 sheets filo pastry","ingredient_11":"1/2 cup olive oil or melted butter (or mixture)","step_1":"Preheat oven to 180°C (350°F)","step_2":"In a large skillet, wilt spinach over medium heat (2-3 minutes). Squeeze out excess water and chop","step_3":"In a large bowl, combine spinach, feta, cottage cheese, green onions, eggs, dill, parsley, nutmeg, salt, and pepper","step_4":"Brush a 20x30cm baking dish with oil","step_5":"Lay one sheet of filo in the dish, brush with oil. Repeat with 6 sheets, layering each direction","step_6":"Spread spinach mixture evenly over the filo","step_7":"Top with remaining 6 filo sheets, brushing each with oil","step_8":"Tuck edges inward to seal","step_9":"Score the top into serving squares","step_10":"Bake for 45-50 minutes until golden brown and crispy","step_11":"Cool for 10 minutes before slicing","step_12":"Serve warm or at room temperature"}
{"_id":"edda22b3-7539-45e4-8db6-90bfdeb3a216","number":273,"title":"BEAN SOUP","cuisine":"Bulgarian","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"2 hours (+ overnight soaking)","servings":"6-8","image_source":"","source":"Traditional Bulgarian recipe","validation":"USDA - white beans provide folate (280mcg/cup), iron (5mg), fiber (15g), protein (15g)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"folate-rich","tag_13":"protein","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"White beans","principal_ingredient_2":"carrots","principal_ingredient_3":"peppers","principal_ingredient_4":"mint","principal_ingredient_5":"paprika","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"BOB CHORBA","freeRecipe":false,"ingredient_1":"500g dry white beans (cannellini or navy), soaked overnight","ingredient_2":"1 onion, chopped","ingredient_3":"2 carrots, diced","ingredient_4":"1 red bell pepper, diced","ingredient_5":"3 tbsp oil","ingredient_6":"1 tbsp paprika (sweet)","ingredient_7":"2 tbsp flour","ingredient_8":"1/4 cup tomato paste","ingredient_9":"Fresh mint (bundle tied with string)","ingredient_10":"Salt to taste","ingredient_11":"1/2 cup fresh parsley, chopped","ingredient_12":"2 tbsp apple cider vinegar or lemon juice","step_1":"Drain soaked beans, place in large pot and cover with fresh water","step_2":"Bring to a boil, then reduce heat and simmer for 1 hour","step_3":"In a separate pan, sauté onion, carrots, and pepper in oil until soft","step_4":"Add paprika and flour, stir for 1 minute","step_5":"Add tomato paste and 1 cup water, stir until smooth","step_6":"Add vegetable mixture to beans","step_7":"Add mint bundle, salt, and continue cooking until beans are very soft (another 45-60 minutes)","step_8":"Remove mint bundle","step_9":"Add parsley and vinegar just before serving","step_10":"Serve hot with crusty bread"}
{"_id":"f756cc60-54d1-49b0-8003-e25b9010c77d","number":274,"title":"CHICKPEA SOUP","cuisine":"Greek","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"2 hours (+ overnight soaking)","servings":"6","image_source":"","source":"Traditional Greek recipe (Sifnos island specialty)","validation":"USDA - chickpeas provide iron (4.7mg/cup), folate (282mcg), protein (14.5g), fiber (12.5g)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"folate","tag_11":"folate-rich","tag_12":"protein","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chickpeas","principal_ingredient_2":"lemon","principal_ingredient_3":"olive oil","principal_ingredient_4":"rosemary","principal_ingredient_5":"bay leaves","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"REVITHIA SOUPA","freeRecipe":false,"ingredient_1":"500g dry chickpeas, soaked overnight","ingredient_2":"1/2 cup olive oil","ingredient_3":"1-2 lemons, juiced","ingredient_4":"1 tsp baking soda (for soaking)","ingredient_5":"1 onion, quartered","ingredient_6":"2 bay leaves","ingredient_7":"1 sprig fresh rosemary","ingredient_8":"Salt and pepper to taste","step_1":"Soak chickpeas overnight with 1 tsp baking soda (this softens skins)","step_2":"Drain and rinse chickpeas thoroughly","step_3":"Place chickpeas in a large pot, cover with water","step_4":"Add onion, bay leaves, and rosemary","step_5":"Bring to a boil, skim off foam, then reduce heat and simmer for 1.5-2 hours until very tender","step_6":"Remove onion, bay leaves, and rosemary","step_7":"In a small bowl, whisk olive oil and lemon juice","step_8":"Slowly drizzle oil-lemon mixture into soup while stirring","step_9":"Season with salt and pepper","step_10":"Serve hot, traditionally with olives and bread"}
{"_id":"3d7696a1-0a04-4e94-8d4a-aab60d651ca7","number":275,"title":"KISELO MLYAKO","cuisine":"Bulgarian","meal_type":"Snack/Breakfast","preparation_difficulty":"Easy","preparation_time":"10 mins (+ 12-24 hours fermentation)","servings":"4 cups","image_source":"","source":"Traditional Bulgarian recipe","validation":"Bulgarian yogurt contains unique Lactobacillus bulgaricus strain with documented probiotic benefits","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"calcium","tag_7":"calcium-rich","tag_8":"protein","tag_9":"probiotics","tag_10":"probiotic-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Milk","principal_ingredient_2":"Bulgarian yogurt starter","principal_ingredient_3":null,"principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"FERMENTED MILK","freeRecipe":false,"ingredient_1":"4 cups whole milk (raw or pasteurized, not ultra-pasteurized)","ingredient_2":"2 tbsp plain Bulgarian yogurt (as starter)","ingredient_3":"Optional: 2 tbsp powdered milk (for thicker consistency)","step_1":"Heat milk in a saucepan to 85°C (185°F) until bubbles form around edges (do not boil)","step_2":"Remove from heat and cool to 43-46°C (110-115°F) - comfortable warm to touch","step_3":"In a small bowl, mix 1/2 cup warm milk with yogurt starter until smooth","step_4":"Pour starter mixture back into remaining milk, stir gently","step_5":"Pour into clean glass jars","step_6":"Cover and keep in a warm place (oven with light on, or wrapped in towels) for 12-24 hours","step_7":"Do not disturb during fermentation","step_8":"After fermentation, transfer to refrigerator","step_9":"Chill before serving","step_10":"Serve plain, with honey, or with fresh fruit"}
