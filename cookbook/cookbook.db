{"_id":"22e940e0-4756-46ef-ba0a-8f39221c3292","number":1,"title":"VEGETABLE CABBAGE STEW","cuisine":"Ukrainian","meal_type":"Soup/Main Course","preparation_difficulty":"Easy","preparation_time":"1 hour","servings":"6","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1788458695278_VEGETABLE_CABBAGE_STEW.png","source":"Traditional Ukrainian Kapusniak (cabbage soup)","validation":"USDA - cabbage provides vitamin C (32mg/cup), vitamin K; potatoes provide potassium; millet provides B vitamins, magnesium","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"vitamin-c","tag_8":"vitamin-c-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Fresh cabbage","principal_ingredient_2":"potatoes","principal_ingredient_3":"carrots","principal_ingredient_4":"onions","principal_ingredient_5":"tomatoes","principal_ingredient_6":"millet or rice","principal_ingredient_7":null,"subtitle":"Kapusniak","freeRecipe":true,"ingredient_1":"1/2 head fresh cabbage, shredded","ingredient_2":"4 medium potatoes, peeled and cubed","ingredient_3":"2 carrots, diced","ingredient_4":"1 large onion, chopped","ingredient_5":"2 tomatoes, chopped (or 1/2 cup tomato sauce)","ingredient_6":"1/2 cup millet or rice, rinsed","ingredient_7":"8 cups vegetable broth or water","ingredient_8":"3 tbsp sunflower oil","ingredient_9":"2 bay leaves","ingredient_10":"Fresh dill and parsley for garnish","ingredient_11":"Salt and pepper to taste","step_1":"In a large pot, heat oil and sauté onion for 5 minutes","step_2":"Add carrots and cook for 3 minutes","step_3":"Add tomatoes and cook for 3 minutes","step_4":"Add cabbage, potatoes, millet, bay leaves, and broth","step_5":"Bring to a boil, then reduce heat and simmer for 25-30 minutes until vegetables and grains are tender","step_6":"Season with salt and pepper","step_7":"Remove bay leaves","step_8":"Garnish with fresh dill and parsley","step_9":"Serve hot with crusty bread"}
{"_id":"4e0b0b90-b626-45f4-b830-5dab52de0c01","number":2,"title":"POTATO PANCAKES","cuisine":"Ukrainian","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"40 mins","servings":"4 (makes 10-12 pancakes)","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1789334951502_POTATO-PANCAKES.png","source":"Traditional Ukrainian recipe","validation":"USDA - potatoes provide vitamin C (20mg each), potassium (900mg each), vitamin B6","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"gluten-free","tag_5":"vitamin-c","tag_6":"vitamin-c-rich","tag_7":"potassium","tag_8":"potassium-rich","tag_9":"NONE","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Potatoes","principal_ingredient_2":"onion","principal_ingredient_3":"egg","principal_ingredient_4":"flour or potato starch","principal_ingredient_5":"sour cream","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Deruny","freeRecipe":true,"ingredient_1":"6 medium potatoes (starchy variety like Russet), peeled","ingredient_2":"1 medium onion","ingredient_3":"2 eggs","ingredient_4":"3 tbsp flour (or potato starch for gluten-free)","ingredient_5":"1 tsp salt","ingredient_6":"1/4 tsp black pepper","ingredient_7":"Sunflower oil for frying","ingredient_8":"Sour cream for serving","step_1":"Finely grate potatoes and onion using the fine side of a box grater","step_2":"Place grated mixture in a clean kitchen towel and squeeze out as much liquid as possible into a bowl","step_3":"Let the squeezed liquid sit for 2 minutes, then pour off the water, reserving the white potato starch at the bottom","step_4":"Return the squeezed potato mixture to the bowl with the reserved starch","step_5":"Add eggs, flour, salt, and pepper, mix well","step_6":"Heat oil in a large skillet over medium-high heat","step_7":"Drop spoonfuls of batter (about 2 tbsp each) into the skillet, flatten slightly with the back of a spoon","step_8":"Fry for 3-4 minutes per side until golden brown and crispy","step_9":"Drain on paper towels","step_10":"Serve hot with a generous dollop of sour cream"}
{"_id":"2efbd78a-a8cd-49e7-b151-aeaf5374bef7","number":3,"title":"STUFFED CABBAGE ROLLS","cuisine":"Ukrainian","meal_type":"Main Course","preparation_difficulty":"Hard","preparation_time":"2 hours","servings":"8 (makes 15-20 rolls)","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1789255846291_STUFFED-CABBAGE-ROLLS.png","source":"Traditional Ukrainian recipe","validation":"USDA - meat provides iron, protein, B12; cabbage provides vitamin C, folate, vitamin K; carrots provide vitamin A","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"contains-meat","tag_5":"contains-dairy","tag_6":"vitamin-a","tag_7":"vitamin-c","tag_8":"iron","tag_9":"iron-rich","tag_10":"fiber","tag_11":"folate","tag_12":"folate-rich","tag_13":"protein","tag_14":"protein-rich","tag_15":"NONE","principal_ingredient_1":"Cabbage leaves","principal_ingredient_2":"ground meat (pork and beef)","principal_ingredient_3":"rice","principal_ingredient_4":"carrots","principal_ingredient_5":"onions","principal_ingredient_6":"tomato sauce","principal_ingredient_7":null,"subtitle":"Holubtsi","freeRecipe":true,"ingredient_1":"1 large head cabbage","ingredient_2":"500g ground meat (mixture of pork and beef)","ingredient_3":"1 cup uncooked rice (any short-grain)","ingredient_4":"2 large carrots, grated","ingredient_5":"2 onions, finely chopped","ingredient_6":"2 cups tomato sauce or crushed tomatoes","ingredient_7":"3 tbsp sunflower oil","ingredient_8":"1 cup sour cream (for serving)","ingredient_9":"Fresh dill for garnish","ingredient_10":"Salt and pepper to taste","step_1":"Carefully remove whole leaves from cabbage (or freeze whole cabbage overnight, then thaw - leaves will be pliable)","step_2":"If using fresh cabbage, blanch leaves in boiling water for 2-3 minutes until soft and pliable","step_3":"Trim thick stems from leaves","step_4":"In a bowl, combine ground meat, uncooked rice, half the grated carrots, half the chopped onions, salt, and pepper","step_5":"Mix thoroughly with hands","step_6":"Place about 2-3 tablespoons of filling near the stem end of each cabbage leaf","step_7":"Fold sides over filling, then roll tightly away from you","step_8":"Repeat with remaining leaves and filling","step_9":"In a large pot, heat oil and sauté remaining onions and carrots for 5 minutes","step_10":"Line the bottom of the pot with a few cabbage leaves","step_11":"Arrange cabbage rolls in layers, seam-side down","step_12":"Pour tomato sauce over the rolls","step_13":"Add enough water to barely cover the rolls","step_14":"Place an inverted plate on top to keep rolls submerged","step_15":"Bring to a boil, then reduce heat to low","step_16":"Cover and simmer for 1 to 1.5 hours","step_17":"Serve hot with sour cream and fresh dill"}
{"_id":"8f8e1d83-1b9a-422c-aa4d-b7d8bccf8ef2","number":4,"title":"LENTIL AND ONION SOUP","cuisine":"Arab","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"45 mins","servings":"6","image_source":"https://raw.githubusercontent.com/P-H-V/FEMIA-images/main/recipe-images/1789005042701_LENTIL-AND-ONION-SOUP.png","source":"Traditional Syrian soup","validation":"USDA - red lentils provide iron (5.5mg/cup), folate (358mcg); onions provide quercetin (antioxidant)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"folate-rich","tag_13":"protein","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Red lentils","principal_ingredient_2":"caramelized onions","principal_ingredient_3":"cumin","principal_ingredient_4":"lemon","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Shorbat Adas bi Bassal","freeRecipe":true,"ingredient_1":"2 cups red lentils, rinsed","ingredient_2":"3 large onions, thinly sliced","ingredient_3":"3 cloves garlic, minced","ingredient_4":"1 tsp ground cumin","ingredient_5":"6 cups vegetable broth","ingredient_6":"1/4 cup lemon juice","ingredient_7":"1/4 cup olive oil","ingredient_8":"Fresh parsley for garnish","ingredient_9":"Salt and pepper to taste","step_1":"Heat olive oil in a large pot over medium-low heat","step_2":"Add onions and cook for 20-25 minutes until deeply caramelized, stirring occasionally","step_3":"Add garlic and cumin, cook for 1 minute","step_4":"Add lentils and broth, bring to a boil","step_5":"Reduce heat and simmer for 20 minutes until lentils are tender","step_6":"Using an immersion blender, puree until smooth","step_7":"Add lemon juice and season with salt and pepper","step_8":"Garnish with fresh parsley","step_9":"Serve hot"}
