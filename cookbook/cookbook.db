{"_id":"861cbdbe-d0e2-40cb-801e-e270385bd434","number":191,"title":"SPINACH AND EGG STEW","cuisine":"Hungarian","meal_type":"Main Course","preparation_difficulty":"Easy","preparation_time":"30 mins","servings":"4","image_source":"","source":"Traditional Hungarian főzelék","validation":"USDA - spinach provides iron (6.4mg/cup cooked), folate (263mcg), vitamin A; eggs provide protein","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-eggs","tag_7":"iron","tag_8":"iron-rich","tag_9":"folate","tag_10":"folate-rich","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Fresh spinach","principal_ingredient_2":"eggs","principal_ingredient_3":"garlic","principal_ingredient_4":"dill","principal_ingredient_5":"sour cream","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Spenót Főzelék","freeRecipe":false,"ingredient_1":"600g fresh spinach (or 400g frozen)","ingredient_2":"4 hard-boiled eggs","ingredient_3":"1 onion, finely chopped","ingredient_4":"2 cloves garlic, minced","ingredient_5":"1 cup sour cream or plain yogurt","ingredient_6":"2 tbsp flour","ingredient_7":"2 tbsp oil","ingredient_8":"1 tsp sugar","ingredient_9":"Salt and pepper to taste","step_1":"Wash spinach thoroughly, remove thick stems","step_2":"In a large pot, heat oil and sauté onion for 5 minutes","step_3":"Add garlic and cook for 1 minute","step_4":"Add spinach in batches, cooking until wilted (3-4 minutes)","step_5":"In a small bowl, mix sour cream with flour until smooth","step_6":"Stir sour cream mixture into spinach","step_7":"Add sugar, salt, and pepper","step_8":"Simmer for 5 minutes until thickened","step_9":"Gently fold in quartered hard-boiled eggs","step_10":"Serve hot with bread or boiled potatoes"}
