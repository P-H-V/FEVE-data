{"_id":"115c7719-b5ee-4b97-81d2-ed414f4826ae","number":110,"title":"RED BEAN SOUP","cuisine":"Chinese","meal_type":"Dessert/Soup","preparation_difficulty":"Easy","preparation_time":"1 hour (+ overnight soaking)","servings":"6","image_source":"","source":"Traditional Chinese sweet soup (tang sui)","validation":"USDA - adzuki beans provide iron (4mg/cup), fiber (16g/cup), folate (278mcg), protein (17g/cup)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"antioxidant-rich","tag_10":"fiber","tag_11":"fiber-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Adzuki beans (red beans)","principal_ingredient_2":"dried orange peel","principal_ingredient_3":"rock sugar","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Hong Dou Tang","freeRecipe":false,"ingredient_1":"2 cups adzuki beans (red beans), soaked overnight","ingredient_2":"1 piece dried orange peel (chen pi) or 1 strip fresh orange zest","ingredient_3":"1/2 cup rock sugar (or brown sugar)","ingredient_4":"8 cups water","step_1":"Drain soaked adzuki beans","step_2":"In a large pot, combine beans, dried orange peel, and water","step_3":"Bring to a boil, then reduce heat and simmer for 1 to 1.5 hours until beans are very soft and breaking down","step_4":"Remove orange peel","step_5":"Add rock sugar and stir until dissolved","step_6":"Using an immersion blender, partially puree (traditional style is chunky)","step_7":"Serve warm"}
{"_id":"9ced7312-62b3-4838-8902-b5d1b3cb1b8b","number":111,"title":"MUNG BEAN SOUP","cuisine":"Chinese","meal_type":"Dessert/Soup","preparation_difficulty":"Easy","preparation_time":"50 mins (+ overnight soaking)","servings":"6","image_source":"","source":"Traditional Chinese sweet soup, often served chilled in summer","validation":"USDA - mung beans provide fiber (15g/cup), iron (3mg/cup), folate (250mcg), protein (14g/cup)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"folate-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Mung beans","principal_ingredient_2":"rock sugar","principal_ingredient_3":"dried orange peel","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Lü Dou Tang","freeRecipe":false,"ingredient_1":"2 cups mung beans (whole, not split), soaked overnight","ingredient_2":"1 piece dried orange peel (chen pi)","ingredient_3":"8 cups water","ingredient_4":"1/2 cup rock sugar (or to taste)","ingredient_5":"Pinch of salt","step_1":"Drain soaked mung beans","step_2":"In a large pot, combine mung beans, dried orange peel, and water","step_3":"Bring to a boil, then reduce heat and simmer for 45 minutes to 1 hour until beans are very soft and some have burst open","step_4":"Remove orange peel","step_5":"Add rock sugar and salt, stir until dissolved","step_6":"Serve warm (traditional summer cooling soup)"}
