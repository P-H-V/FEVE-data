{"_id":"ee226b26-420f-4249-a020-d908e4e891f5","number":317,"title":"CHICKEN SOUP WITH MATZO BALLS","cuisine":"Jewish","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"2 hours 30 mins","servings":"8","image_source":"","source":"Traditional Ashkenazi Jewish recipe","validation":"USDA - chicken provides protein, iron, zinc; carrots provide vitamin A; eggs provide protein, vitamin D","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"gluten-free","tag_5":"contains-meat","tag_6":"contains-eggs","tag_7":"vitamin-a","tag_8":"iron","tag_9":"iron-rich","tag_10":"zinc","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chicken","principal_ingredient_2":"carrots","principal_ingredient_3":"celery","principal_ingredient_4":"parsnips","principal_ingredient_5":"dill","principal_ingredient_6":"matzo meal","principal_ingredient_7":"eggs","subtitle":"Kneidlach","freeRecipe":false,"ingredient_1":"**For the soup:**","ingredient_2":"1 whole chicken (about 1.5 kg), cut into pieces","ingredient_3":"3 carrots, peeled and cut into large chunks","ingredient_4":"3 celery stalks, cut into large chunks","ingredient_5":"2 parsnips, peeled and cut into large chunks","ingredient_6":"1 onion, halved","ingredient_7":"1 leek (white part only), halved","ingredient_8":"1 bunch fresh dill","ingredient_9":"1 bunch fresh parsley","ingredient_10":"8 cloves garlic, unpeeled","ingredient_11":"10 cups cold water","ingredient_12":"1 tbsp salt","ingredient_13":"1/2 tsp black peppercorns","ingredient_14":"**For matzo balls (kneidlach):**","ingredient_15":"1 cup matzo meal (or gluten-free matzo meal)","ingredient_16":"4 large eggs","ingredient_17":"1/4 cup schmaltz (chicken fat) or vegetable oil","ingredient_18":"1/4 cup water or seltzer water (for fluffier balls)","ingredient_19":"1 tsp salt","ingredient_20":"1/4 tsp white pepper","step_1":"Place chicken pieces in a large stockpot with cold water","step_2":"Bring to a gentle simmer, skimming off foam as it rises","step_3":"Add carrots, celery, parsnips, onion, leek, dill, parsley, garlic, salt, and peppercorns","step_4":"Reduce heat to low, cover partially, and simmer for 2 hours","step_5":"Strain broth through a fine-mesh sieve. Reserve chicken meat (shred) and carrots for serving","step_6":"For matzo balls: beat eggs in a bowl","step_7":"Add schmaltz, water, salt, and pepper, mix well","step_8":"Fold in matzo meal, stir until combined","step_9":"Refrigerate mixture for 30 minutes","step_10":"Bring a large pot of salted water to a boil","step_11":"Wet hands and roll matzo mixture into 1-inch balls","step_12":"Drop matzo balls into boiling water","step_13":"Reduce heat, cover, and simmer for 30-40 minutes until puffed","step_14":"To serve: reheat soup, add shredded chicken, sliced carrots, and matzo balls","step_15":"Garnish with fresh dill"}
{"_id":"15f8d281-602b-48c7-a502-bba761587d2d","number":318,"title":"COLD BEET SOUP WITH YOGURT","cuisine":"Jewish","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"20 mins (+ chilling)","servings":"4","image_source":"","source":"Traditional Israeli/Sephardi cold soup","validation":"USDA - beets provide folate (136mcg/cup); yogurt provides calcium, probiotics; beets provide betalains","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"calcium","tag_7":"calcium-rich","tag_8":"iron","tag_9":"folate","tag_10":"folate-rich","tag_11":"probiotics","tag_12":"probiotic-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Cooked beets","principal_ingredient_2":"yogurt","principal_ingredient_3":"garlic","principal_ingredient_4":"fresh dill","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Salat Sela","freeRecipe":false,"ingredient_1":"4 medium beets, cooked, peeled, and grated","ingredient_2":"2 cups plain yogurt (full-fat)","ingredient_3":"2 cloves garlic, minced","ingredient_4":"1 cup cold water (adjust for desired consistency)","ingredient_5":"2 tbsp lemon juice","ingredient_6":"2 tbsp fresh dill, chopped","ingredient_7":"1 tbsp olive oil","ingredient_8":"Salt and white pepper to taste","ingredient_9":"Roasted walnuts for garnish (optional)","step_1":"Grate cooked beets into a large bowl","step_2":"In a separate bowl, whisk yogurt with cold water until smooth","step_3":"Add minced garlic, lemon juice, salt, and pepper to yogurt mixture","step_4":"Pour yogurt mixture over grated beets","step_5":"Stir in fresh dill","step_6":"Chill for at least 2 hours","step_7":"Before serving, drizzle with olive oil","step_8":"Garnish with roasted walnuts and additional fresh dill","step_9":"Serve cold"}
{"_id":"fdaecf71-779a-424e-b61b-f40abe5dcc75","number":319,"title":"SPINACH AND CHEESE LATKES","cuisine":"Jewish","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"40 mins","servings":"4 (makes 10-12 latkes)","image_source":"","source":"Jewish spinach latkes variation","validation":"USDA - spinach provides iron (6.4mg/cup cooked), folate (263mcg); eggs provide protein; cheese provides calcium","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"calcium","tag_8":"calcium-rich","tag_9":"iron","tag_10":"iron-rich","tag_11":"folate","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Spinach","principal_ingredient_2":"cottage cheese or feta","principal_ingredient_3":"eggs","principal_ingredient_4":"matzo meal","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"400g fresh spinach, chopped (or 300g frozen, thawed and squeezed)","ingredient_2":"4 eggs","ingredient_3":"1 cup cottage cheese or crumbled feta cheese","ingredient_4":"1/2 cup matzo meal (or breadcrumbs)","ingredient_5":"1/2 cup grated Parmesan cheese","ingredient_6":"2 cloves garlic, minced","ingredient_7":"1/2 tsp nutmeg","ingredient_8":"Salt and pepper to taste","ingredient_9":"Oil for frying (olive or sunflower)","step_1":"If using fresh spinach, wilt in a hot pan for 2-3 minutes, then squeeze out excess water","step_2":"Finely chop the spinach","step_3":"In a large bowl, beat eggs","step_4":"Add chopped spinach, cottage cheese, matzo meal, Parmesan, garlic, nutmeg, salt, and pepper","step_5":"Mix well until combined","step_6":"Heat oil in a large skillet over medium-high heat","step_7":"Drop spoonfuls of batter (about 2 tbsp each) into the skillet","step_8":"Flatten slightly with the back of a spoon","step_9":"Fry for 2-3 minutes per side until golden brown and crispy","step_10":"Drain on paper towels","step_11":"Serve hot with sour cream or applesauce"}
{"_id":"8f412c9f-0cd7-4d95-b370-bbe97b1c0db2","number":320,"title":"PERSIMMON AND WALNUT SALAD","cuisine":"Jewish","meal_type":"Salad","preparation_difficulty":"Easy","preparation_time":"15 mins","servings":"4","image_source":"","source":"Traditional Moroccan Jewish salad","validation":"USDA - persimmons provide vitamin A, vitamin C; walnuts provide omega-3 (2.5g/oz), vitamin E","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"ovulatory-phase-week-3","tag_3":"fertility-supporting","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"vitamin-a","tag_8":"vitamin-c","tag_9":"vitamin-c-rich","tag_10":"antioxidant-rich","tag_11":"omega-3","tag_12":"omega-3-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Persimmons (or mangoes)","principal_ingredient_2":"walnuts","principal_ingredient_3":"orange blossom water","principal_ingredient_4":"cinnamon","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Salat de Kaki","freeRecipe":false,"ingredient_1":"4 ripe persimmons (Fuyu variety), thinly sliced","ingredient_2":"1/2 cup walnuts, toasted and crushed","ingredient_3":"1 tbsp orange blossom water (optional)","ingredient_4":"1 tbsp honey","ingredient_5":"1 tbsp lemon juice","ingredient_6":"1/2 tsp cinnamon","ingredient_7":"Fresh mint for garnish","step_1":"Slice persimmons thinly (no need to peel if Fuyu variety)","step_2":"Arrange persimmon slices on a serving platter","step_3":"In a small bowl, whisk orange blossom water, honey, lemon juice, and cinnamon","step_4":"Drizzle dressing over persimmons","step_5":"Top with crushed walnuts","step_6":"Garnish with fresh mint","step_7":"Let sit for 5 minutes before serving"}
{"_id":"28a6c363-305a-45aa-9266-c972130333be","number":321,"title":"EGG AND ONION SOUP","cuisine":"Jewish","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"35 mins","servings":"4","image_source":"","source":"Traditional Libyan Jewish soup","validation":"USDA - eggs provide protein (6g each), vitamin D, vitamin B12, selenium; onions provide quercetin (antioxidant)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-eggs","tag_7":"vitamin-d","tag_8":"iron","tag_9":"iron-rich","tag_10":"protein","tag_11":"protein-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggs","principal_ingredient_2":"caramelized onions","principal_ingredient_3":"turmeric","principal_ingredient_4":"chicken broth (or vegetable)","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Beid Farch","freeRecipe":false,"ingredient_1":"2 large onions, thinly sliced","ingredient_2":"4 large eggs","ingredient_3":"4 cups vegetable or chicken broth","ingredient_4":"1 tsp turmeric","ingredient_5":"1/4 cup olive oil","ingredient_6":"Salt and white pepper to taste","ingredient_7":"Fresh parsley for garnish","step_1":"Heat olive oil in a large pot over medium-low heat","step_2":"Add onions and cook for 15-20 minutes until deeply caramelized, stirring occasionally","step_3":"Add turmeric and cook for 1 minute","step_4":"Add broth and bring to a simmer","step_5":"In a small bowl, beat eggs with a fork","step_6":"Slowly pour beaten eggs into the simmering soup while stirring gently","step_7":"Cook for 2-3 minutes until eggs are set in ribbons","step_8":"Season with salt and white pepper","step_9":"Garnish with fresh parsley","step_10":"Serve hot with crusty bread"}
