{"_id":"ae068680-a1ff-43d2-a697-d9d988eca5ee","number":305,"title":"SPINACH AND EGG GRATIN","cuisine":"Scandinavian","meal_type":"Main Course","preparation_difficulty":"Easy","preparation_time":"40 mins","servings":"4","image_source":"","source":"Traditional Swedish recipe","validation":"USDA - spinach provides iron (6.4mg/cup cooked), folate (263mcg), calcium; eggs provide protein, vitamin D","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-dairy","tag_7":"contains-eggs","tag_8":"calcium","tag_9":"calcium-rich","tag_10":"iron","tag_11":"iron-rich","tag_12":"folate","tag_13":"protein","tag_14":"protein-rich","tag_15":"NONE","principal_ingredient_1":"Spinach","principal_ingredient_2":"eggs","principal_ingredient_3":"milk","principal_ingredient_4":"cheese","principal_ingredient_5":"breadcrumbs","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Spenatgratäng","freeRecipe":false,"ingredient_1":"500g fresh spinach (or 400g frozen, thawed)","ingredient_2":"4 hard-boiled eggs, sliced","ingredient_3":"2 cups milk","ingredient_4":"3 tbsp butter","ingredient_5":"3 tbsp flour","ingredient_6":"1 cup grated cheese (Gruyère or Emmental)","ingredient_7":"1/2 cup breadcrumbs (optional)","ingredient_8":"Pinch of nutmeg","ingredient_9":"Salt and pepper to taste","step_1":"Preheat oven to 200°C (400°F)","step_2":"If using fresh spinach, wilt in a hot pan for 2-3 minutes, then squeeze out excess water","step_3":"Grease a baking dish","step_4":"Layer half the spinach on the bottom of the dish","step_5":"Arrange sliced hard-boiled eggs over spinach","step_6":"Top with remaining spinach","step_7":"Make béchamel: melt butter in a saucepan, add flour, cook for 2 minutes","step_8":"Gradually whisk in milk, cook until thickened","step_9":"Stir in half the grated cheese, nutmeg, salt, and pepper","step_10":"Pour béchamel over spinach and eggs","step_11":"Top with remaining cheese and breadcrumbs","step_12":"Bake for 20-25 minutes until bubbly and golden","step_13":"Serve hot with a salad"}
