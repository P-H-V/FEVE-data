{"_id":"f329afbb-eaa8-4a20-8b62-3c59d626154a","number":237,"title":"CHICKPEA STEW","cuisine":"Ethiopian","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"30 mins","servings":"4","image_source":"","source":"Ethiopian shiro wat","validation":"Chickpea flour provides iron, protein, fiber; berbere spice contains anti-inflammatory compounds","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron-rich","tag_8":"protein-rich","tag_9":"NONE","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chickpea flour (besan)","principal_ingredient_2":"onion","principal_ingredient_3":"garlic","principal_ingredient_4":"berbere spice","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Shiro Wat","freeRecipe":false,"ingredient_1":"1 cup chickpea flour (besan)","ingredient_2":"1 large onion, finely chopped","ingredient_3":"4 cloves garlic, minced","ingredient_4":"1 inch ginger, grated","ingredient_5":"2 tbsp berbere spice (or paprika + cayenne)","ingredient_6":"3 cups vegetable broth","ingredient_7":"1/4 cup oil","ingredient_8":"Salt to taste","step_1":"In a dry pan, toast chickpea flour over medium heat for 3-4 minutes until fragrant, set aside","step_2":"Heat oil in a pot over medium heat","step_3":"Sauté onion for 5-7 minutes until golden brown","step_4":"Add garlic and ginger, cook for 1 minute","step_5":"Add berbere spice, cook for 1 minute","step_6":"Add 1 cup broth, stir to deglaze","step_7":"Slowly whisk in chickpea flour, then add remaining broth","step_8":"Simmer for 10-15 minutes until thickened, stirring frequently","step_9":"Season with salt","step_10":"Serve hot with injera or rice"}
