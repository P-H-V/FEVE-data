p_10":"Serve hot"}
{"_id":"733cb18f-6f9c-4fef-9859-7ec589fac63a","number":202,"title":"BERRY KISSEL","cuisine":"Belarusian","meal_type":"Dessert/Beverage","preparation_difficulty":"Easy","preparation_time":"20 mins (+ chilling)","servings":"4","image_source":"","source":"Traditional Belarusian/Russian drink/dessert","validation":"USDA - berries provide vitamin C, anthocyanins (powerful antioxidants for egg quality)","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"vitamin-c","tag_7":"vitamin-c-rich","tag_8":"antioxidants","tag_9":"antioxidant-rich","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Fresh or frozen berries (cranberries","principal_ingredient_2":"lingonberries","principal_ingredient_3":"or black currants)","principal_ingredient_4":"potato starch","principal_ingredient_5":"sugar","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Yagodniy Kisel","freeRecipe":false,"ingredient_1":"500g fresh or frozen berries (cranberries, lingonberries, black currants, or mixed)","ingredient_2":"1/2 cup sugar (or honey to taste)","ingredient_3":"4 cups water","ingredient_4":"3-4 tbsp potato starch","ingredient_5":"1 tbsp lemon juice (optional)","step_1":"In a saucepan, combine berries, sugar, and water","step_2":"Bring to a boil, then reduce heat and simmer for 10 minutes","step_3":"Strain through a sieve to remove skins (or leave chunky)","step_4":"Return liquid to pot","step_5":"In a small bowl, dissolve potato starch in 1/2 cup cold water","step_6":"Slowly pour starch mixture into simmering berry liquid, stirring constantly","step_7":"Cook for 2-3 minutes until thickened and translucent","step_8":"Add lemon juice if using","step_9":"Pour into serving glasses or bowls","step_10":"Let cool to room temperature, then refrigerate until set (about 2 hours)","step_11":"Serve chilled"}
{"_id":"d3886825-cfa6-4e5a-b986-c4d06e1e8d08","number":203,"title":"SPINACH & FETA OMELETTE","cuisine":"French","meal_type":"Breakfast","preparation_difficulty":"Easy","preparation_time":"15 mins","servings":"1","image_source":"","source":"https://en.wikibooks.org/wiki/Cookbook:Omelette","validation":"USDA - eggs provide iron (0.9mg), protein (18g), vitamin D; spinach provides iron (6.4mg/cup cooked)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-dairy","tag_7":"contains-eggs","tag_8":"calcium","tag_9":"iron","tag_10":"iron-supporting","tag_11":"magnesium","tag_12":"protein","tag_13":"protein-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggs","principal_ingredient_2":"spinach","principal_ingredient_3":"feta cheese","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"3 large eggs","ingredient_2":"2 cups fresh spinach","ingredient_3":"30g feta cheese, crumbled","ingredient_4":"1 tbsp olive oil","ingredient_5":"1 tbsp milk (optional)","ingredient_6":"Salt and pepper to taste","step_1":"Whisk eggs in a bowl with milk, salt, and pepper","step_2":"Heat olive oil in a non-stick pan over medium heat","step_3":"Add spinach and sauté for 1 minute until wilted","step_4":"Pour eggs over spinach, spread evenly","step_5":"Cook for 2-3 minutes until edges set","step_6":"Sprinkle feta cheese over half the omelette","step_7":"Fold the omelette in half","step_8":"Cook for another 1-2 minutes","step_9":"Slide onto plate and serve hot"}
