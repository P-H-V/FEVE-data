{"_id":"88842860-91b6-4836-87b8-edb445aad2af","number":62,"title":"STUFFED GRAPE LEAVES","cuisine":"Armenian","meal_type":"Appetizer/Main Course","preparation_difficulty":"Hard","preparation_time":"1 hour 30 mins","servings":"6 (makes ~40 rolls)","image_source":"","source":"Traditional Armenian recipe","validation":"USDA - grape leaves provide vitamin K, vitamin A, folate; rice provides carbohydrates","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"antioxidants","tag_7":"antioxidant-rich","tag_8":"fiber","tag_9":"fiber-rich","tag_10":"folate","tag_11":"folate-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Grape leaves","principal_ingredient_2":"rice","principal_ingredient_3":"onion","principal_ingredient_4":"herbs","principal_ingredient_5":"lemon","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Yalanchi","freeRecipe":false,"ingredient_1":"1 jar grape leaves (about 50 leaves), rinsed","ingredient_2":"1 cup short-grain rice, washed","ingredient_3":"2 onions, finely chopped","ingredient_4":"1/2 cup fresh parsley, chopped","ingredient_5":"1/2 cup fresh dill, chopped","ingredient_6":"1/2 cup fresh mint, chopped","ingredient_7":"1/2 cup olive oil","ingredient_8":"2 lemons, juiced","ingredient_9":"1 tsp allspice","ingredient_10":"Salt and pepper to taste","step_1":"Rinse grape leaves well, separate, and drain","step_2":"In a pan, sauté onions in 1/4 cup olive oil until soft","step_3":"Add rice, herbs, half the lemon juice, allspice, salt, and pepper","step_4":"Cook for 5 minutes, stirring frequently","step_5":"Add 1 cup water, bring to a boil, then reduce heat and simmer until water is absorbed","step_6":"Place a grape leaf shiny-side down, stem end toward you","step_7":"Place 1 tsp filling near stem end","step_8":"Fold sides over filling, then roll tightly away from you","step_9":"Line a large pot with unused or torn grape leaves","step_10":"Arrange dolmas tightly in layers","step_11":"Add remaining olive oil, remaining lemon juice, and enough water to barely cover","step_12":"Place an inverted plate on top to keep dolmas submerged","step_13":"Bring to a boil, reduce heat to low, and simmer for 45 minutes","step_14":"Let cool to room temperature","step_15":"Serve with lemon wedges"}
