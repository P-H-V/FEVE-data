{"_id":"f12d17fe-2bd7-47e0-9f96-75513f438227","number":94,"title":"LENTIL AND ESCAROLE SOUP","cuisine":"Italian","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"45 mins","servings":"4","image_source":"","source":"Traditional Italian recipe","validation":"USDA - brown lentils provide iron (6.6mg/cup), folate (358mcg), fiber (16g); escarole provides vitamin K","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"folate","tag_11":"folate-rich","tag_12":"protein","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Brown lentils","principal_ingredient_2":"escarole or kale","principal_ingredient_3":"carrots","principal_ingredient_4":"celery","principal_ingredient_5":"garlic","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Zuppa di Lenticchie e Scarola","freeRecipe":false,"ingredient_1":"1 cup brown or green lentils, rinsed","ingredient_2":"1 head escarole (or kale), chopped into bite-sized pieces","ingredient_3":"1 onion, finely chopped","ingredient_4":"2 carrots, diced","ingredient_5":"2 celery stalks, diced","ingredient_6":"3 cloves garlic, minced","ingredient_7":"6 cups vegetable broth","ingredient_8":"1 bay leaf","ingredient_9":"1 sprig fresh rosemary","ingredient_10":"1/4 cup extra virgin olive oil","ingredient_11":"Salt and black pepper to taste","ingredient_12":"Red pepper flakes (optional)","ingredient_13":"Grated Parmesan for serving (optional)","step_1":"Heat olive oil in a large pot over medium heat","step_2":"Sauté onion, carrots, and celery for 5-7 minutes until softened","step_3":"Add garlic and red pepper flakes, cook for 1 minute until fragrant","step_4":"Add lentils, broth, bay leaf, and rosemary sprig","step_5":"Bring to a boil, then reduce heat and simmer for 25 minutes","step_6":"Add chopped escarole and simmer for another 10 minutes until lentils are tender and escarole is wilted","step_7":"Remove bay leaf and rosemary sprig","step_8":"Season with salt and black pepper","step_9":"Serve hot with a drizzle of olive oil and optional Parmesan cheese"}
{"_id":"52ddb2b4-a357-4635-8281-e16acc52ed4d","number":95,"title":"WHITE BEAN AND KALE SOUP","cuisine":"Italian","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"50 mins (+ overnight soaking if using dried beans)","servings":"4-6","image_source":"","source":"Traditional Tuscan recipe","validation":"USDA - cannellini beans provide iron (5mg/cup), folate (280mcg), fiber (15g); kale provides calcium (150mg/cup)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"calcium","tag_8":"iron","tag_9":"iron-rich","tag_10":"fiber","tag_11":"fiber-rich","tag_12":"folate","tag_13":"folate-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Cannellini beans","principal_ingredient_2":"kale (cavolo nero)","principal_ingredient_3":"carrots","principal_ingredient_4":"celery","principal_ingredient_5":"garlic","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Zuppa di Cavolo Nero e Cannellini","freeRecipe":false,"ingredient_1":"2 cups cooked cannellini beans (or 1 can, drained and rinsed)","ingredient_2":"1 bunch cavolo nero (Tuscan kale), stems removed, leaves chopped","ingredient_3":"1 onion, finely chopped","ingredient_4":"2 carrots, diced","ingredient_5":"2 celery stalks, diced","ingredient_6":"3 cloves garlic, minced","ingredient_7":"1 sprig fresh rosemary","ingredient_8":"1 bay leaf","ingredient_9":"6 cups vegetable broth","ingredient_10":"1/4 cup extra virgin olive oil","ingredient_11":"Salt and black pepper to taste","ingredient_12":"Crusty bread for serving","step_1":"Heat olive oil in a large pot over medium heat","step_2":"Sauté onion, carrots, and celery for 5-7 minutes until softened","step_3":"Add garlic and cook for 1 minute until fragrant","step_4":"Add half the beans, broth, rosemary, and bay leaf","step_5":"Bring to a boil, then reduce heat and simmer for 20 minutes","step_6":"Puree the soup slightly with an immersion blender for creaminess","step_7":"Add remaining whole beans and chopped kale","step_8":"Simmer for another 10-15 minutes until kale is tender","step_9":"Remove rosemary and bay leaf","step_10":"Season with salt and black pepper","step_11":"Serve hot with a drizzle of olive oil and crusty bread"}
{"_id":"695ad4a0-ca02-4193-afc9-a3945efa9f63","number":96,"title":"SPINACH AND RICOTTA TORtellini","cuisine":"Italian","meal_type":"Main Course","preparation_difficulty":"Hard","preparation_time":"1 hour (+ resting)","servings":"4","image_source":"","source":"Traditional Italian recipe","validation":"USDA - spinach provides iron (6.4mg/cup cooked), folate, vitamin A; ricotta provides calcium","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"calcium","tag_8":"calcium-rich","tag_9":"iron","tag_10":"iron-rich","tag_11":"folate","tag_12":"protein","tag_13":"protein-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Spinach","principal_ingredient_2":"ricotta cheese","principal_ingredient_3":"eggs","principal_ingredient_4":"Parmesan","principal_ingredient_5":"nutmeg","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"with Broth","freeRecipe":false,"ingredient_1":"**For pasta dough:**","ingredient_2":"300g \"00\" flour (or all-purpose flour)","ingredient_3":"3 large eggs","ingredient_4":"Pinch of salt","ingredient_5":"**For filling:**","ingredient_6":"250g fresh spinach (or 200g frozen, thawed and squeezed)","ingredient_7":"250g whole milk ricotta cheese","ingredient_8":"50g Parmesan cheese, finely grated","ingredient_9":"1 egg yolk","ingredient_10":"Pinch of nutmeg","ingredient_11":"Salt and pepper to taste","ingredient_12":"**For serving:**","ingredient_13":"1.5 liters vegetable or chicken broth","ingredient_14":"Parmesan cheese for garnish","step_1":"For pasta dough: mound flour on a work surface, make a well in center","step_2":"Crack eggs into well, add salt, and beat with a fork","step_3":"Gradually incorporate flour from edges until a dough forms","step_4":"Knead for 8-10 minutes until smooth and elastic","step_5":"Wrap in plastic and rest for 30 minutes","step_6":"For filling: blanch spinach in boiling water for 1 minute, then plunge into ice water","step_7":"Squeeze spinach completely dry, then finely chop","step_8":"In a bowl, combine chopped spinach, ricotta, Parmesan, egg yolk, nutmeg, salt, and pepper","step_9":"Roll pasta dough into thin sheets (about 1mm thickness)","step_10":"Cut into 4cm squares","step_11":"Place 1/2 tsp filling in center of each square","step_12":"Fold into triangles, press edges to seal, then bring corners together to form tortellini","step_13":"Bring broth to a gentle simmer","step_14":"Cook tortellini in simmering broth for 3-4 minutes until they float","step_15":"Serve in bowls with broth and grated Parmesan"}
{"_id":"1ca113a8-3bfd-4b7e-abde-69c3b30a3d6a","number":97,"title":"CHICKPEA AND ROSEMARY SOUP","cuisine":"Italian","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"40 mins (+ overnight soaking if using dried)","servings":"4","image_source":"","source":"Traditional Italian recipe","validation":"USDA - chickpeas provide iron (4.7mg/cup), folate (282mcg), protein (14.5g), fiber (12.5g)","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"folate-rich","tag_13":"protein","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chickpeas","principal_ingredient_2":"rosemary","principal_ingredient_3":"garlic","principal_ingredient_4":"olive oil","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Zuppa di Ceci e Rosmarino","freeRecipe":false,"ingredient_1":"2 cups cooked chickpeas (or 1 can, drained and rinsed)","ingredient_2":"1 onion, finely chopped","ingredient_3":"3 cloves garlic, minced","ingredient_4":"2 sprigs fresh rosemary","ingredient_5":"2 tablespoons tomato paste","ingredient_6":"4 cups vegetable broth","ingredient_7":"1/4 cup extra virgin olive oil","ingredient_8":"Salt and black pepper to taste","ingredient_9":"Croutons or crusty bread for serving","step_1":"Heat olive oil in a large pot over medium heat","step_2":"Sauté onion for 5 minutes until soft","step_3":"Add garlic and rosemary sprigs, cook for 1 minute until fragrant","step_4":"Add tomato paste and cook for 2 minutes, stirring constantly","step_5":"Add chickpeas and broth, bring to a boil","step_6":"Reduce heat and simmer for 20 minutes","step_7":"Remove rosemary sprigs","step_8":"Puree half the soup with an immersion blender for creamy texture","step_9":"Season with salt and pepper","step_10":"Serve hot with a drizzle of olive oil and crusty bread"}
{"_id":"eeb57664-d40b-4d0b-bb59-b42a97e28c70","number":98,"title":"CAPONATA","cuisine":"Italian","meal_type":"Side Dish/Condiment","preparation_difficulty":"Medium","preparation_time":"40 mins","servings":"6 (as side dish)","image_source":"","source":"Traditional Sicilian recipe","validation":"USDA - eggplant provides fiber (12g per whole) and anthocyanins; tomatoes provide lycopene","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"vitamin-c","tag_7":"antioxidants","tag_8":"antioxidant-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggplant","principal_ingredient_2":"tomatoes","principal_ingredient_3":"olives","principal_ingredient_4":"capers","principal_ingredient_5":"celery","principal_ingredient_6":"pine nuts","principal_ingredient_7":null,"subtitle":"SICILIAN EGGPLANT RELISH","freeRecipe":false,"ingredient_1":"2 large eggplants, cut into 2cm cubes","ingredient_2":"2 celery stalks, diced","ingredient_3":"1 onion, chopped","ingredient_4":"2 cloves garlic, minced","ingredient_5":"400g crushed tomatoes","ingredient_6":"1/2 cup green olives, pitted and halved","ingredient_7":"2 tbsp capers, rinsed","ingredient_8":"1/4 cup red wine vinegar","ingredient_9":"2 tbsp sugar (or honey)","ingredient_10":"1/4 cup pine nuts, toasted (optional)","ingredient_11":"1/2 cup olive oil (for frying)","ingredient_12":"Salt and black pepper to taste","ingredient_13":"Fresh basil for garnish","step_1":"Salt eggplant cubes and let sit for 30 minutes to remove bitterness, then pat dry","step_2":"Heat half the olive oil in a large pan over medium-high heat","step_3":"Fry eggplant in batches until golden brown on all sides (about 5 minutes per batch)","step_4":"Remove eggplant and set aside","step_5":"In the same pan, add remaining oil and sauté celery and onion for 5 minutes","step_6":"Add garlic and cook for 1 minute","step_7":"Add crushed tomatoes, vinegar, sugar, olives, and capers","step_8":"Simmer for 10 minutes","step_9":"Return eggplant to the pan and simmer for another 10 minutes","step_10":"Season with salt and pepper","step_11":"Stir in toasted pine nuts","step_12":"Serve warm or at room temperature","step_13":"Garnish with fresh basil"}
