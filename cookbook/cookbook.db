{"_id":"ca887e07-5992-4d98-88c1-f9e5f6774dc1","number":145,"title":"CHEESE AND POPPY SEED MADELEINES","cuisine":"French","meal_type":"Snack/Appetizer","preparation_difficulty":"Medium","preparation_time":"35 mins","servings":"12 madeleines","image_source":"","source":"French savoury madeleine adaptation","validation":"USDA - Gruyère provides calcium (717mg/100g), protein (30g/100g); eggs provide protein, B12","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"healthy-fats","tag_8":"calcium","tag_9":"calcium-rich","tag_10":"protein","tag_11":"protein-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggs","principal_ingredient_2":"flour","principal_ingredient_3":"Gruyère cheese","principal_ingredient_4":"poppy seeds","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Madeleines au Fromage et Graines de Pavot","freeRecipe":false,"ingredient_1":"100g all-purpose flour","ingredient_2":"2 eggs","ingredient_3":"80g salted butter, melted and cooled","ingredient_4":"50g Gruyère cheese, finely grated","ingredient_5":"1 tbsp poppy seeds","ingredient_6":"1/2 tsp baking powder","ingredient_7":"Pinch of salt","ingredient_8":"Freshly ground black pepper","step_1":"Preheat oven to 190°C (375°F)","step_2":"Butter a madeleine pan","step_3":"In a bowl, whisk eggs until frothy","step_4":"Add cooled melted butter and whisk to combine","step_5":"In a separate bowl, mix flour, baking powder, salt, and pepper","step_6":"Fold dry ingredients into wet ingredients","step_7":"Fold in grated Gruyère and poppy seeds","step_8":"Spoon batter into madeleine molds (3/4 full)","step_9":"Bake for 10-12 minutes until golden and springy to touch","step_10":"Cool for 2 minutes, then remove from pan","step_11":"Serve warm or at room temperature"}
{"_id":"65a31826-2ed6-4cfb-8c1b-8afa45bb27b1","number":146,"title":"PRUNE AND ARMAGNAC COMPOTE","cuisine":"French","meal_type":"Snack/Dessert","preparation_difficulty":"Easy","preparation_time":"20 mins (+ soaking)","servings":"4","image_source":"","source":"Traditional Gascon recipe","validation":"USDA - prunes (dried plums) provide fiber (12g/cup), potassium, vitamin K, iron","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"iron","tag_7":"potassium","tag_8":"antioxidant-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Prunes (dried plums)","principal_ingredient_2":"Armagnac (or cognac)","principal_ingredient_3":"vanilla","principal_ingredient_4":"cinnamon","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Compote de Pruneaux à l'Armagnac","freeRecipe":false,"ingredient_1":"250g pitted prunes","ingredient_2":"1/2 cup Armagnac (or cognac/rum)","ingredient_3":"1/2 cup water","ingredient_4":"1 cinnamon stick","ingredient_5":"1 vanilla bean (or 1 tsp vanilla extract)","ingredient_6":"1 tbsp honey (optional)","ingredient_7":"1 strip lemon zest","step_1":"Place prunes in a saucepan","step_2":"Add Armagnac, water, cinnamon stick, vanilla bean, lemon zest, and honey","step_3":"Bring to a gentle simmer over low heat","step_4":"Simmer for 10-15 minutes until prunes are plump and liquid slightly reduced","step_5":"Remove from heat and let cool","step_6":"Remove cinnamon stick, vanilla bean, and lemon zest","step_7":"Serve warm or at room temperature","step_8":"Store in refrigerator for up to 2 weeks"}
{"_id":"76bd7c09-0a5f-4e73-bdad-d26983f9e677","number":147,"title":"CAULIFLOWER GRATIN","cuisine":"French","meal_type":"Side Dish/Main Course","preparation_difficulty":"Medium","preparation_time":"50 mins","servings":"4","image_source":"","source":"Traditional French recipe","validation":"USDA - cauliflower provides vitamin C (70mg/cup), fiber, folate; Gruyère provides calcium","confidence":"Supported","tag_1":"fertility-supporting","tag_2":"pregnancy-month-4-6","tag_3":"vegetarian","tag_4":"gluten-free","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"vitamin-c","tag_8":"vitamin-c-rich","tag_9":"calcium","tag_10":"calcium-rich","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Cauliflower","principal_ingredient_2":"Gruyère cheese","principal_ingredient_3":"milk","principal_ingredient_4":"butter","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Gratin de Chou-Fleur","freeRecipe":false,"ingredient_1":"1 large head cauliflower, cut into florets","ingredient_2":"2 cups milk","ingredient_3":"50g butter","ingredient_4":"50g flour","ingredient_5":"150g Gruyère cheese, grated","ingredient_6":"1/2 cup breadcrumbs (optional)","ingredient_7":"Pinch of nutmeg","ingredient_8":"Salt and pepper to taste","step_1":"Preheat oven to 190°C (375°F)","step_2":"Steam or boil cauliflower florets for 5-7 minutes until just tender","step_3":"Drain well and place in a buttered gratin dish","step_4":"Make béchamel: melt butter in a saucepan, add flour, cook for 2 minutes","step_5":"Gradually whisk in milk, cook until thickened","step_6":"Stir in 100g grated Gruyère, nutmeg, salt, and pepper","step_7":"Pour sauce over cauliflower","step_8":"Top with remaining 50g Gruyère and breadcrumbs","step_9":"Bake for 20-25 minutes until bubbly and golden","step_10":"Serve hot"}
{"_id":"d1d6a8ad-6401-42d2-9a0a-df6fd21f9395","number":148,"title":"BUCKWHEAT AND SPINACH GALETTES","cuisine":"French","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"45 mins (+ resting)","servings":"4 (4 galettes)","image_source":"","source":"Traditional Breton recipe (galette complète variation)","validation":"USDA - buckwheat provides magnesium (100mg/cup), iron (1.5mg/cup); spinach provides iron (6.4mg/cup)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"gluten-free","tag_6":"contains-dairy","tag_7":"contains-eggs","tag_8":"iron","tag_9":"iron-rich","tag_10":"magnesium","tag_11":"folate","tag_12":"protein","tag_13":"protein-rich","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Buckwheat flour","principal_ingredient_2":"eggs","principal_ingredient_3":"spinach","principal_ingredient_4":"milk","principal_ingredient_5":"Gruyère","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Galettes de Sarrasin aux Épinards","freeRecipe":false,"ingredient_1":"**For galette batter:**","ingredient_2":"200g buckwheat flour","ingredient_3":"1 egg","ingredient_4":"500ml water (or mixture of water and milk)","ingredient_5":"1 tsp salt","ingredient_6":"Butter for cooking","ingredient_7":"**For filling (per galette):**","ingredient_8":"Large handful fresh spinach, wilted","ingredient_9":"1 egg","ingredient_10":"1/4 cup Gruyère cheese, grated","ingredient_11":"Salt and pepper to taste","step_1":"In a bowl, whisk buckwheat flour, egg, salt, and water until smooth","step_2":"Let batter rest for 30 minutes at room temperature","step_3":"Wilt spinach in a hot pan for 2 minutes, squeeze out excess water","step_4":"Heat a non-stick crepe pan over medium-high heat","step_5":"Add a small amount of butter, then pour in 1/2 cup batter","step_6":"Swirl to coat pan evenly","step_7":"Cook for 1-2 minutes until edges lift and bottom is set","step_8":"Sprinkle grated cheese over galette","step_9":"Add wilted spinach in the center","step_10":"Crack an egg onto the spinach","step_11":"Season with salt and pepper","step_12":"Fold edges of galette inward to form a square","step_13":"Cover and cook for 2-3 minutes until egg white is set","step_14":"Serve immediately"}
{"_id":"8a528269-206e-4c37-8b7e-a747cb285a63","number":149,"title":"PUMPKIN SOUP","cuisine":"French","meal_type":"Soup","preparation_difficulty":"Easy","preparation_time":"40 mins","servings":"4-6","image_source":"","source":"Traditional French recipe","validation":"USDA - pumpkin provides extremely high vitamin A (17000 IU/cup), fiber, vitamin C","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"vitamin-a","tag_8":"vitamin-a-rich","tag_9":"antioxidant-rich","tag_10":"fiber","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Pumpkin or butternut squash","principal_ingredient_2":"onion","principal_ingredient_3":"potato","principal_ingredient_4":"crème fraîche (optional)","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Velouté de Courge","freeRecipe":false,"ingredient_1":"1 kg pumpkin or butternut squash, peeled and cubed","ingredient_2":"1 onion, chopped","ingredient_3":"1 potato, peeled and cubed","ingredient_4":"2 cloves garlic, minced","ingredient_5":"4 cups vegetable broth","ingredient_6":"1/4 cup crème fraîche or heavy cream (optional)","ingredient_7":"2 tbsp butter or olive oil","ingredient_8":"1 sprig fresh thyme","ingredient_9":"Salt and pepper to taste","ingredient_10":"Toasted pumpkin seeds for garnish","step_1":"Heat butter in a large pot over medium heat","step_2":"Sauté onion for 5 minutes until soft","step_3":"Add garlic and cook for 1 minute","step_4":"Add pumpkin, potato, thyme, and broth","step_5":"Bring to a boil, then reduce heat and simmer for 20 minutes until vegetables are tender","step_6":"Remove thyme sprig","step_7":"Puree soup with an immersion blender until smooth","step_8":"Stir in crème fraîche if using","step_9":"Season with salt and pepper","step_10":"Garnish with toasted pumpkin seeds"}
{"_id":"d405db8e-43b7-47c5-98d3-8c336ef068fd","number":150,"title":"ENDIVE AND APPLE SALAD","cuisine":"French","meal_type":"Salad","preparation_difficulty":"Easy","preparation_time":"10 mins","servings":"4","image_source":"","source":"Traditional French bistro salad","validation":"USDA - endives provide fiber, vitamin K, folate; walnuts provide omega-3 (2.5g/oz)","confidence":"Supported","tag_1":"follicular-phase-week-2","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"gluten-free","tag_6":"vitamin-c","tag_7":"vitamin-c-rich","tag_8":"fiber","tag_9":"fiber-rich","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Belgian endives","principal_ingredient_2":"apples","principal_ingredient_3":"walnuts","principal_ingredient_4":"lemon vinaigrette","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Salade d'Endives aux Pommes","freeRecipe":false,"ingredient_1":"4 Belgian endives, thinly sliced crosswise","ingredient_2":"2 crisp apples (Pink Lady or Granny Smith), julienned","ingredient_3":"1/4 cup walnuts, toasted and chopped","ingredient_4":"2 tbsp fresh parsley or chives, chopped","ingredient_5":"**For vinaigrette:**","ingredient_6":"3 tbsp olive oil","ingredient_7":"1 tbsp lemon juice","ingredient_8":"1 tsp Dijon mustard","ingredient_9":"1 tsp honey","ingredient_10":"Salt and pepper to taste","step_1":"Slice endives thinly (about 1cm thick)","step_2":"In a small bowl, whisk olive oil, lemon juice, Dijon mustard, honey, salt, and pepper","step_3":"In a serving bowl, combine sliced endives, julienned apples, and walnuts","step_4":"Pour dressing over and toss gently","step_5":"Garnish with fresh herbs","step_6":"Serve immediately (endives brown quickly)"}
{"_id":"18ab6599-6c7c-4b0d-900d-4afb17d2f4f5","number":151,"title":"FISH SOUP","cuisine":"French","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"4","image_source":"","source":"Traditional Provençal recipe","validation":"NIH - white fish (cod) provides protein (20g/100g), selenium (46mcg), omega-3 (0.3g), vitamin D","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"pregnancy-month-7-9","tag_4":"pescatarian","tag_5":"gluten-free","tag_6":"contains-fish","tag_7":"vitamin-d","tag_8":"selenium","tag_9":"omega-3","tag_10":"omega-3-rich","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"White fish (rockfish","principal_ingredient_2":"cod","principal_ingredient_3":"or haddock)","principal_ingredient_4":"tomatoes","principal_ingredient_5":"saffron","principal_ingredient_6":"fennel","principal_ingredient_7":null,"subtitle":"Soupe de Poisson","freeRecipe":false,"ingredient_1":"500g white fish fillets (rockfish, cod, or haddock), cut into chunks","ingredient_2":"1 onion, chopped","ingredient_3":"1 leek, sliced","ingredient_4":"1 fennel bulb, sliced","ingredient_5":"2 carrots, diced","ingredient_6":"3 cloves garlic, minced","ingredient_7":"3 tomatoes, chopped (or 1 can crushed tomatoes)","ingredient_8":"4 cups fish stock or vegetable broth","ingredient_9":"1/2 cup dry white wine","ingredient_10":"1 pinch saffron threads","ingredient_11":"1 sprig fresh thyme","ingredient_12":"1 bay leaf","ingredient_13":"1/4 cup olive oil","ingredient_14":"Salt and pepper to taste","ingredient_15":"Rouille (garlic mayonnaise) and croutons for serving","step_1":"Heat olive oil in a large pot over medium heat","step_2":"Sauté onion, leek, fennel, and carrots for 5-7 minutes","step_3":"Add garlic and cook for 1 minute","step_4":"Add tomatoes, white wine, saffron, thyme, and bay leaf","step_5":"Add fish stock and bring to a boil","step_6":"Reduce heat and simmer for 20 minutes","step_7":"Add fish chunks and cook for 5-7 minutes until fish is opaque and flakes easily","step_8":"Remove thyme and bay leaf","step_9":"Serve hot with rouille and croutons"}
{"_id":"0acf1e30-3f4c-4720-b4a4-b1f1211836ce","number":152,"title":"CABBAGE AND MUSHROOM QUICHE","cuisine":"French","meal_type":"Main Course","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"6","image_source":"","source":"French quiche adaptation","validation":"USDA - cabbage provides vitamin C (32mg/cup), vitamin K; eggs provide protein; Gruyère provides calcium","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"vegetarian","tag_5":"contains-dairy","tag_6":"contains-eggs","tag_7":"vitamin-c","tag_8":"vitamin-c-rich","tag_9":"calcium","tag_10":"calcium-rich","tag_11":"protein","tag_12":"protein-rich","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Cabbage","principal_ingredient_2":"mushrooms","principal_ingredient_3":"eggs","principal_ingredient_4":"cream","principal_ingredient_5":"Gruyère cheese","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Quiche aux Choux et Champignons","freeRecipe":false,"ingredient_1":"1 pre-made pie crust","ingredient_2":"1/2 head green cabbage, finely shredded","ingredient_3":"200g mushrooms, sliced","ingredient_4":"1 onion, chopped","ingredient_5":"2 cloves garlic, minced","ingredient_6":"3 eggs","ingredient_7":"1 cup heavy cream or crème fraîche","ingredient_8":"100g Gruyère cheese, grated","ingredient_9":"2 tbsp butter","ingredient_10":"Pinch of nutmeg","ingredient_11":"Salt and pepper to taste","step_1":"Preheat oven to 180°C (350°F)","step_2":"Blind bake pie crust for 10 minutes","step_3":"In a large skillet, melt butter over medium heat","step_4":"Sauté onion until soft (5 minutes)","step_5":"Add cabbage and cook for 8-10 minutes until wilted","step_6":"Add mushrooms and garlic, cook for 5 more minutes","step_7":"Remove from heat and let cool slightly","step_8":"In a bowl, whisk eggs with cream, nutmeg, salt, and pepper","step_9":"Add cooked vegetables and half the grated Gruyère to egg mixture","step_10":"Pour filling into pre-baked crust","step_11":"Top with remaining Gruyère","step_12":"Bake for 35-40 minutes until set and golden","step_13":"Let cool for 10 minutes before slicing"}
{"_id":"ab172450-86d4-45ad-8039-db93c93a7352","number":153,"title":"MUSHROOM AND PARSLEY OMLETTE","cuisine":"French","meal_type":"Breakfast/Main Course","preparation_difficulty":"Easy","preparation_time":"15 mins","servings":"1","image_source":"","source":"Traditional French omelette","validation":"USDA - eggs provide protein (6g each), selenium (15mcg each), vitamin D, vitamin B12","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"pregnancy-month-7-9","tag_4":"vegetarian","tag_5":"contains-eggs","tag_6":"vitamin-d","tag_7":"vitamin-d-rich","tag_8":"selenium","tag_9":"protein","tag_10":"protein-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggs","principal_ingredient_2":"mushrooms","principal_ingredient_3":"fresh parsley","principal_ingredient_4":"butter","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Omelette aux Champignons et Persil","freeRecipe":false,"ingredient_1":"3 large eggs","ingredient_2":"100g mushrooms, sliced","ingredient_3":"1 tbsp fresh parsley, finely chopped","ingredient_4":"1 tbsp butter","ingredient_5":"Salt and pepper to taste","step_1":"In a bowl, whisk eggs with salt and pepper until frothy","step_2":"Stir in chopped parsley","step_3":"Heat butter in a non-stick pan over medium-high heat","step_4":"Add mushrooms and cook for 3-4 minutes until golden","step_5":"Pour eggs over mushrooms","step_6":"Stir gently with a spatula, pushing cooked eggs toward center","step_7":"When eggs are mostly set but still soft on top (about 1-2 minutes), fold omelette in half","step_8":"Slide onto a plate and serve immediately"}
{"_id":"c6db4704-ffca-4309-bdfe-e5688ec4ce08","number":154,"title":"PEAR AND ALMOND TART","cuisine":"French","meal_type":"Dessert","preparation_difficulty":"Hard","preparation_time":"1 hour 15 mins","servings":"8","image_source":"","source":"Traditional French tart","validation":"USDA - pears provide fiber (6g each), vitamin C; almonds provide vitamin E (7mg/oz), magnesium","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"contains-dairy","tag_5":"contains-eggs","tag_6":"healthy-fats","tag_7":"vitamin-c","tag_8":"magnesium","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Pears","principal_ingredient_2":"almonds","principal_ingredient_3":"butter","principal_ingredient_4":"eggs","principal_ingredient_5":"flour","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Tarte aux Poires et Amandes","freeRecipe":false,"ingredient_1":"**For crust:**","ingredient_2":"200g all-purpose flour","ingredient_3":"100g cold butter, cubed","ingredient_4":"50g powdered sugar","ingredient_5":"1 egg yolk","ingredient_6":"2 tbsp cold water","ingredient_7":"**For frangipane:**","ingredient_8":"100g almond meal","ingredient_9":"100g butter, softened","ingredient_10":"100g sugar","ingredient_11":"2 eggs","ingredient_12":"2 tbsp flour","ingredient_13":"**For topping:**","ingredient_14":"3 ripe pears (Bartlett or Anjou), peeled, cored, and thinly sliced","ingredient_15":"2 tbsp sliced almonds","step_1":"For crust: pulse flour, butter, and sugar in food processor until sandy","step_2":"Add egg yolk and water, pulse until dough forms","step_3":"Press into a tart pan, chill for 30 minutes","step_4":"Preheat oven to 180°C (350°F)","step_5":"Blind bake crust for 15 minutes","step_6":"For frangipane: beat butter and sugar until creamy","step_7":"Add eggs one at a time","step_8":"Fold in almond meal and flour","step_9":"Spread frangipane into pre-baked crust","step_10":"Arrange pear slices in a circular pattern on top","step_11":"Sprinkle with sliced almonds","step_12":"Bake for 35-40 minutes until golden brown","step_13":"Cool completely before removing from pan"}
{"_id":"a0265752-18aa-4384-9868-d8d261d8c3fb","number":155,"title":"CHOCOLATE MOUSSE","cuisine":"French","meal_type":"Dessert","preparation_difficulty":"Medium","preparation_time":"30 mins (+ chilling)","servings":"4","image_source":"","source":"Traditional French recipe","validation":"USDA/NIH - dark chocolate (70-85% cocoa) provides antioxidants (flavonoids), iron (3.4mg/oz), magnesium (16mg/oz)","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"gluten-free","tag_5":"iron","tag_6":"magnesium","tag_7":"antioxidants","tag_8":"antioxidant-rich","tag_9":"NONE","tag_10":"NONE","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Dark chocolate","principal_ingredient_2":"eggs","principal_ingredient_3":"sugar","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Mousse au Chocolat","freeRecipe":false,"ingredient_1":"200g dark chocolate (70% cocoa or higher), broken into pieces","ingredient_2":"4 large eggs, separated","ingredient_3":"2 tbsp sugar (optional)","ingredient_4":"Pinch of salt","step_1":"Melt chocolate in a double boiler or microwave in short bursts","step_2":"Let chocolate cool slightly","step_3":"In a bowl, whisk egg yolks until pale, then whisk into melted chocolate","step_4":"In a separate bowl, beat egg whites with salt until stiff peaks form","step_5":"Gently fold half the egg whites into chocolate mixture to lighten","step_6":"Fold in remaining egg whites until just combined (do not overmix)","step_7":"Spoon into serving glasses or ramekins","step_8":"Refrigerate for at least 4 hours","step_9":"Serve chilled"}
