{"_id":"b2d632d6-a23f-4eb1-b3a8-b4a39a7cc7ef","number":120,"title":"OATCAKES","cuisine":"Scottish","meal_type":"Snack/Breakfast","preparation_difficulty":"Medium","preparation_time":"30 mins","servings":"12 oatcakes","image_source":"","source":"Traditional Scottish recipe","validation":"USDA - oatmeal provides fiber (8g/cup), magnesium (120mg/cup), iron (3.5mg/cup)","confidence":"Supported","tag_1":"luteal-phase-week-4","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"vegan","tag_5":"dairy-free","tag_6":"iron","tag_7":"magnesium","tag_8":"magnesium-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Oatmeal (medium ground)","principal_ingredient_2":"butter or coconut oil","principal_ingredient_3":"salt","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"","freeRecipe":false,"ingredient_1":"2 cups medium ground oatmeal (or oat flour)","ingredient_2":"1/2 tsp salt","ingredient_3":"1/4 tsp baking soda","ingredient_4":"2 tbsp butter or coconut oil, melted","ingredient_5":"1/2 cup hot water (approx)","step_1":"Preheat oven to 180°C (350°F)","step_2":"In a bowl, mix oatmeal, salt, and baking soda","step_3":"Add melted butter and mix","step_4":"Gradually add hot water until a stiff dough forms","step_5":"On a surface dusted with oatmeal, roll dough to 1/4 inch thickness","step_6":"Cut into rounds or triangles","step_7":"Transfer to a greased baking sheet","step_8":"Bake for 15-18 minutes until edges are golden and oatcakes are crisp","step_9":"Cool on a wire rack","step_10":"Serve with cheese, butter, or jam"}
