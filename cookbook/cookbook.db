eason with salt and pepper","step_10":"Garnish with fresh parsley","step_11":"Serve hot with crusty bread"}
{"_id":"3a778bdf-5bc5-440f-aec1-8e2a702997bc","number":298,"title":"WATERZOOI","cuisine":"Belgian","meal_type":"Soup/Main Course","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"6","image_source":"","source":"Traditional Belgian Flemish recipe","validation":"USDA - chicken provides protein (25g/150g), B12, selenium; cream provides calcium, vitamin A","confidence":"Supported","tag_1":"ovulatory-phase-week-3","tag_2":"fertility-supporting","tag_3":"pregnancy-month-7-9","tag_4":"contains-meat","tag_5":"contains-dairy","tag_6":"vitamin-d","tag_7":"calcium","tag_8":"calcium-rich","tag_9":"protein","tag_10":"protein-rich","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chicken","principal_ingredient_2":"leeks","principal_ingredient_3":"carrots","principal_ingredient_4":"celery","principal_ingredient_5":"cream","principal_ingredient_6":"egg yolks","principal_ingredient_7":null,"subtitle":"CREAMY CHICKEN STEW","freeRecipe":false,"ingredient_1":"600g chicken breast and thighs, cut into pieces","ingredient_2":"3 leeks (white part only), sliced","ingredient_3":"2 carrots, diced","ingredient_4":"2 celery stalks, diced","ingredient_5":"1 onion, chopped","ingredient_6":"4 cups chicken broth","ingredient_7":"1 cup heavy cream","ingredient_8":"2 egg yolks","ingredient_9":"2 tbsp butter","ingredient_10":"1 lemon, juiced","ingredient_11":"Fresh parsley and thyme for garnish","ingredient_12":"Salt and white pepper to taste","step_1":"In a large pot, melt butter and sauté onion, leeks, carrots, and celery for 5 minutes","step_2":"Add chicken pieces and cook until lightly browned (5-7 minutes)","step_3":"Add chicken broth and bring to a boil","step_4":"Reduce heat and simmer for 30 minutes until chicken is cooked through","step_5":"Remove chicken, shred or cut into bite-sized pieces, return to pot","step_6":"In a bowl, whisk egg yolks with heavy cream and lemon juice","step_7":"Slowly temper the cream mixture by adding a ladle of hot broth while whisking","step_8":"Stir tempered cream into the soup","step_9":"Heat gently (do not boil) until thickened","step_10":"Season with salt and white pepper","step_11":"Garnish with fresh parsley and thyme","step_12":"Serve hot with crusty bread"}
{"_id":"4af5f621-bf2c-4fb8-af61-7f16dc004b7b","number":299,"title":"CURRY SPLIT PEA SOUP","cuisine":"Dutch","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"1 hour 30 mins (+ overnight soaking)","servings":"8","image_source":"","source":"Traditional Dutch recipe (variation with curry)","validation":"USDA - split peas provide iron (4mg/cup), protein (16g), fiber (16g); bacon provides protein, B12","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"gluten-free","tag_5":"contains-meat","tag_6":"iron","tag_7":"iron-rich","tag_8":"fiber","tag_9":"fiber-rich","tag_10":"protein","tag_11":"NONE","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Split green peas","principal_ingredient_2":"smoked sausage","principal_ingredient_3":"bacon","principal_ingredient_4":"curry powder","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Snert","freeRecipe":false,"ingredient_1":"2 cups dried split green peas, soaked overnight","ingredient_2":"300g smoked sausage, sliced","ingredient_3":"150g bacon, diced","ingredient_4":"2 leeks, sliced","ingredient_5":"2 celery stalks, diced","ingredient_6":"2 carrots, diced","ingredient_7":"3 potatoes, diced","ingredient_8":"1 onion, chopped","ingredient_9":"1 tbsp curry powder","ingredient_10":"1 bay leaf","ingredient_11":"8 cups water","ingredient_12":"Fresh parsley and celery leaves for garnish","ingredient_13":"Salt and pepper to taste","step_1":"Drain soaked peas","step_2":"In a large pot, cook bacon until crispy, remove and set aside","step_3":"In the same pot, sauté onion for 5 minutes","step_4":"Add curry powder and cook for 1 minute","step_5":"Add peas, bay leaf, and water, bring to a boil","step_6":"Skim off foam, reduce heat and simmer for 1 hour","step_7":"Add leeks, celery, carrots, potatoes, and cooked bacon","step_8":"Continue simmering for 30 minutes until vegetables are tender and peas have broken down","step_9":"Add smoked sausage in the last 10 minutes","step_10":"Remove bay leaf","step_11":"Season with salt and pepper","step_12":"Garnish with fresh parsley and celery leaves","step_13":"Serve hot (traditionally thicker on day 2)"}
