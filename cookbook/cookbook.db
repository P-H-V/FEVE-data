{"_id":"6812b5fb-d5f3-4feb-a8dc-159078164a8a","number":100,"title":"WEDDING SOUP","cuisine":"Italian","meal_type":"Soup","preparation_difficulty":"Medium","preparation_time":"1 hour","servings":"6","image_source":"","source":"Traditional Italian-American recipe (origins in Campania)","validation":"USDA - chicken provides protein (25g/150g); escarole provides vitamins A, C, K, and folate","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-4-6","tag_4":"contains-meat","tag_5":"contains-eggs","tag_6":"vitamin-c","tag_7":"iron","tag_8":"iron-rich","tag_9":"folate","tag_10":"protein","tag_11":"protein-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Chicken or turkey meatballs","principal_ingredient_2":"escarole or kale","principal_ingredient_3":"chicken broth","principal_ingredient_4":null,"principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Minestra Maritata","freeRecipe":false,"ingredient_1":"**For meatballs:**","ingredient_2":"300g ground chicken or turkey","ingredient_3":"1/2 cup breadcrumbs (or almond flour for gluten-free)","ingredient_4":"1/4 cup Parmesan cheese, grated","ingredient_5":"1 egg","ingredient_6":"2 tbsp fresh parsley, chopped","ingredient_7":"1 clove garlic, minced","ingredient_8":"Salt and pepper to taste","ingredient_9":"**For soup:**","ingredient_10":"1 head escarole (or kale), chopped","ingredient_11":"1 onion, diced","ingredient_12":"2 carrots, diced","ingredient_13":"2 celery stalks, diced","ingredient_14":"2 cloves garlic, minced","ingredient_15":"2 liters chicken broth","ingredient_16":"1/4 cup olive oil","ingredient_17":"Parmesan cheese for serving","step_1":"In a bowl, combine ground meat, breadcrumbs, Parmesan, egg, parsley, garlic, salt, and pepper","step_2":"Roll into small meatballs (about 2cm diameter)","step_3":"Heat olive oil in a large pot over medium heat","step_4":"Sauté onion, carrots, and celery for 5-7 minutes","step_5":"Add garlic and cook for 1 minute","step_6":"Pour in chicken broth and bring to a simmer","step_7":"Gently add meatballs to the simmering broth","step_8":"Cook for 15 minutes","step_9":"Add chopped escarole and cook for 5-10 minutes until wilted","step_10":"Season with salt and pepper","step_11":"Serve hot with grated Parmesan cheese"}
{"_id":"64a93180-fb1f-40b5-9dda-1d5a29c617f2","number":101,"title":"ROASTED CAULIFLOWER AND LENTIL PASTA","cuisine":"Italian","meal_type":"Main Course","preparation_difficulty":"Easy","preparation_time":"40 mins","servings":"4","image_source":"","source":"Original recipe inspired by Italian cucina povera","validation":"USDA - lentils provide iron (7.5mg/cup), folate (479mcg); cauliflower provides vitamin C (70mg/cup)","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"pregnancy-month-1-3","tag_4":"vegetarian","tag_5":"vegan","tag_6":"gluten-free","tag_7":"iron","tag_8":"iron-rich","tag_9":"fiber","tag_10":"fiber-rich","tag_11":"folate","tag_12":"folate-rich","tag_13":"protein","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Pasta","principal_ingredient_2":"cauliflower","principal_ingredient_3":"brown lentils","principal_ingredient_4":"garlic","principal_ingredient_5":"rosemary","principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Pasta con Lenticchie e Cavolfiore","freeRecipe":false,"ingredient_1":"300g whole wheat pasta (or gluten-free)","ingredient_2":"1 cup brown lentils, rinsed","ingredient_3":"1 small cauliflower, cut into florets","ingredient_4":"1 onion, finely chopped","ingredient_5":"3 cloves garlic, minced","ingredient_6":"1 sprig fresh rosemary","ingredient_7":"4 cups vegetable broth","ingredient_8":"1/4 cup olive oil","ingredient_9":"2 tbsp tomato paste","ingredient_10":"Salt and black pepper to taste","ingredient_11":"Red pepper flakes (optional)","ingredient_12":"Fresh parsley for garnish","step_1":"Preheat oven to 220°C (425°F)","step_2":"Toss cauliflower florets with 2 tbsp olive oil, salt, and pepper","step_3":"Roast for 20 minutes until golden and tender","step_4":"In a large pot, heat remaining olive oil over medium heat","step_5":"Sauté onion for 5 minutes until soft","step_6":"Add garlic and rosemary, cook for 1 minute","step_7":"Add lentils, broth, tomato paste, and red pepper flakes","step_8":"Bring to a boil, then reduce heat and simmer for 25 minutes","step_9":"Cook pasta according to package instructions","step_10":"When lentils are tender, remove rosemary sprig","step_11":"Add roasted cauliflower to the lentil mixture","step_12":"Drain pasta and add to the pot","step_13":"Toss to combine, adding pasta water if needed","step_14":"Season with salt and pepper","step_15":"Garnish with fresh parsley and serve"}
{"_id":"372d66af-4883-4a44-9cc2-d6028c6a752e","number":102,"title":"BAKED OMELET WITH MASHED POTATOES","cuisine":"Italian","meal_type":"Breakfast/Lunch","preparation_difficulty":"Medium","preparation_time":"35 mins","servings":"4","image_source":"","source":"Traditional Italian recipe","validation":"USDA - eggs provide protein (6g each), selenium (15mcg each), vitamin B12, vitamin D","confidence":"Supported","tag_1":"menstrual-phase-week-1","tag_2":"fertility-supporting","tag_3":"vegetarian","tag_4":"gluten-free","tag_5":"contains-eggs","tag_6":"vitamin-b12","tag_7":"iron","tag_8":"iron-rich","tag_9":"selenium","tag_10":"protein","tag_11":"protein-rich","tag_12":"NONE","tag_13":"NONE","tag_14":"NONE","tag_15":"NONE","principal_ingredient_1":"Eggs","principal_ingredient_2":"potatoes","principal_ingredient_3":"Parmesan cheese","principal_ingredient_4":"onion","principal_ingredient_5":null,"principal_ingredient_6":null,"principal_ingredient_7":null,"subtitle":"Frittata di Patate","freeRecipe":false,"ingredient_1":"8 large eggs","ingredient_2":"3 medium potatoes (about 500g), boiled and mashed or thinly sliced","ingredient_3":"1 onion, finely chopped","ingredient_4":"1/2 cup Parmesan cheese, grated","ingredient_5":"1/4 cup milk","ingredient_6":"2 tbsp olive oil","ingredient_7":"Salt and black pepper to taste","ingredient_8":"Fresh rosemary or parsley for garnish","step_1":"Preheat oven to 180°C (350°F)","step_2":"Boil potatoes until tender, then drain and mash (or slice thinly)","step_3":"In a bowl, whisk eggs with milk, salt, and pepper","step_4":"Stir in mashed potatoes, Parmesan cheese, and chopped onion","step_5":"Heat olive oil in an oven-safe skillet over medium heat","step_6":"Pour egg mixture into skillet","step_7":"Cook without stirring for 3-4 minutes until edges set","step_8":"Transfer skillet to the oven","step_9":"Bake for 15-20 minutes until frittata is puffed and golden","step_10":"Let cool for 5 minutes","step_11":"Slide onto a plate or serve directly from skillet","step_12":"Garnish with fresh herbs"}
